# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN THIỆP CƯỚI (CHI PHÍ 0 ĐỒNG / THÁNG)
# Sao chép tệp này thành .env.local để điền các khóa API miễn phí của bạn
# ==============================================================================

# 1. SUPABASE DATABASE (500MB miễn phí, chứa 10.000+ đám cưới)
# Lấy tại: https://supabase.com -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. CLOUDFLARE R2 STORAGE (10GB lưu trữ miễn phí, 0đ chi phí băng thông tải về)
# Lấy tại: https://dash.cloudflare.com -> R2 Object Storage -> Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=thiep-cuoi-assets
R2_PUBLIC_DOMAIN=https://cdn.thiepcuoixinh.com

# 3. CẤU HÌNH DOMAIN & WEBSITE
NEXT_PUBLIC_SITE_URL=http://localhost:3005
