    "timeline": {
      "list": [
        {
          "id": "1",
          "date": "설렘",
          "title": "Chỉ một dòng hồi âm cũng khiến tâm trạng thăng trầm",
          "imagePath": "/templates/dcdb503f-a949-4ac8-83c9-0f73c3f3fec3/images/TXl5UDdBWGVWaF8xNzg5MjQzODg4XzU0aw.png",
          "description": "Khi nhận được hồi âm thì bỗng dưng mỉm cười\nKhi không thấy hồi âm thì bỗng dưng thấy hụt hẫng\nHồi ấy, có lẽ ai cũng đều như vậy."
        },
        {
          "id": "2",
          "date": "연애",
          "title": "Chẳng biết đã bắt đầu từ khi nào",
          "imagePath": "/templates/dcdb503f-a949-4ac8-83c9-0f73c3f3fec3/images/Mzl0ZDEyZ3hEQV8xNzg5MjQzODg1X2Y1Zw.png",
          "description": "Không biết chính xác là từ khi nào\nNhưng từ một khoảnh khắc nào đó, sự hiện diện của nhau trở nên đương nhiên\nVà chuyện tình yêu cứ thế bắt đầu."
        },
        {
          "id": "3",
          "date": "현실",
          "title": "Chúng con cũng đã cãi nhau khá nhiều.",
          "imagePath": "",
          "description": "Chúng ta khác nhau nhiều hơn mình tưởng\nCãi nhau cũng nhiều hơn mình tưởng\nNhưng lại làm hòa nhanh hơn mình tưởng."
        },
        {
          "id": "4",
          "date": "이해",
          "title": "Rốt cuộc, lại là người ấy",
          "imagePath": "/templates/dcdb503f-a949-4ac8-83c9-0f73c3f3fec3/images/UklJQnBzOW9vOV8xNzg5MjQzOTA1XzJncw.png",
          "description": "Dẫu đôi lúc cãi vã, giận hờn\nNgười mà cuối cùng ta lại tìm về\nVẫn luôn là người ấy."
        },
        {
          "id": "5",
          "date": "확신",
          "title": "Nếu là người ấy thì có lẽ sẽ ổn thôi",
          "imagePath": "/templates/dcdb503f-a949-4ac8-83c9-0f73c3f3fec3/images/amQyVmRURTlVWV8xNzg5MjQzOTEwX3NkeQ.png",
          "description": "Có một khoảnh khắc, tôi đã tin chắc rằng\nngười mình muốn cùng đi qua những ngày tháng phía trước\nchính là người ấy."
        }
      ],
      "type": "v1",
      "title": "Từ gặp gỡ đến yêu thương",
      "enabled": false,
      "subtitle": "Những khoảnh khắc làm nên chúng ta",
      "coverImage": "/templates/dcdb503f-a949-4ac8-83c9-0f73c3f3fec3/images/aGphOW5YbEI3Ul8xNzg5MjQzOTA4X3hxdg.png"
    },
    "interview": {
      "enabled": false,
      "title": "Câu chuyện của hai chúng tôi",
      "description": "Trước thềm hôn lễ, chúng tôi đã chuẩn bị\nbuổi phỏng vấn của hai chúng tôi.",
      "items": [
        {
          "id": "1",
          "title": "Q1. Hãy giới thiệu chú rể và cô dâu",
          "description": "👦 Chú rể Kim Jin-ho (ISTJ)\nLà người lên kế hoạch kỹ càng, không giỏi bộc lộ cảm xúc nhưng chân tình sâu đậm.\nNhững lời hứa nhỏ cũng không quên, luôn để tâm chu toàn, và cả những lời phàn nàn mà tôi tưởng chỉ là tự nói một mình, anh ấy cũng nhớ.\nVì ít nói nên đôi khi bị hiểu lầm, nhưng là kiểu người lặng lẽ thể hiện bằng hành động.\nCâu nói ‘người đàn ông tự thay cả bóng đèn hỏng’ phải chăng là dành cho Jin-ho? 😎\nVới cô dâu, anh luôn là người đàn ông vững chãi, mọi chuyện đều kết thúc bằng “Được rồi~” 💪🤍\n\n👰 Cô dâu Lee Na-eun (ENFP)\nLà một cỗ máy cảm xúc ngày nào cũng cười, khóc, ríu rít không ngớt 🚀\nDùng sự hài hước và năng lượng để thắp sáng bầu không khí, dù mới gặp cũng có thể chia sẻ chuyện đời.\nĐó cũng là lý do cô ấy hợp với Jin-ho, người luôn nghiêm túc đáp lại những lời cô ấy tự nói một mình.\nThích những chuyến đi ngẫu hứng, nhưng điều quan trọng là luôn trở về nhà an toàn!\nLà người con gái vừa lãng mạn vừa thực tế, đáng yêu và vững vàng, hôm nay cũng khiến Jin-ho mỉm cười 🌸😌"
        },
        {
          "id": "2",
          "title": "Q2. Hai người đã gặp nhau như thế nào?",
          "description": "Vào một ngày mà chúng tôi còn chưa biết tên nhau, hai người đã ngồi đối diện nhau trong buổi gặp gỡ của những người quen.\nTrong rất nhiều người, chúng tôi là hai người ở lại đến cuối cùng.\nCuộc trò chuyện giữa Jin-ho ít nói và Na-eun nói nhiều có chút ngượng ngùng,\nnhưng khoảng thời gian ấy lại thoải mái một cách lạ lùng, và chúng tôi cứ thế tự nhiên giữ liên lạc với nhau.\nBan đầu, tôi chỉ nghĩ anh ấy là một người tốt, nhưng đến một khoảnh khắc nào đó,\ntôi chợt nghĩ: “Giá như người này là người bên mình”.\nNghĩ lại bây giờ, bầu không khí ngày hôm ấy… phải chăng chính là định mệnh? 🍀🌙"
        },
        {
          "id": "3",
          "title": "Q3. Điều gì đã khiến hai người quyết định kết hôn?",
          "description": "Khi yêu một người lâu dài, người ta cũng dễ trở nên chai sạn vì sự quen thuộc, phải không?\nNhưng với chúng tôi thì ngược lại. Càng theo thời gian, chúng tôi càng trở thành những người tốt hơn dành cho nhau.\nDù có những lúc tranh cãi, cuối cùng chúng tôi vẫn cùng ăn cơm, cùng cười và khép lại một ngày,\nvà tôi nhận ra chúng tôi đã trở thành người bạn thoải mái nhất, đồng thời là gia đình của nhau.\nRồi một ngày, không có một sự kiện hoành tráng nào,\ngiữa những ngày thường bình dị, chúng tôi ôm thật chặt lấy nhau và nói:\n“Hay là mình cứ sống cùng nhau nhé?”\nĐó chính là lời cầu hôn thật sự của chúng tôi 💍"
        },
        {
          "id": "4",
          "title": "Q4. Hai người có lời hứa nào cho cuộc sống hôn nhân sắp tới?",
          "description": "Vì chúng con có nhiều điểm giống nhau, cũng có nhiều điểm khác biệt,\nnên mỗi ngày sẽ là một hành trình học hỏi và thấu hiểu lẫn nhau.\nKhi giận nhau, chúng con sẽ không chiến tranh lạnh mà hòa giải ngay,\nvà đôi khi vẫn muốn có những ngày xao xuyến như đang hẹn hò.\nNgày vui chúng con sẽ chia sẻ, ngày buồn cũng sẽ cùng nhau san sẻ.\nViệc nhà sẽ được phân chia công bằng bằng ‘kéo✌️ búa✊ bao✋’,\nthay vì băn khoăn ‘hôm nay ai nấu cơm’, chúng con sẽ nói ‘mình cùng ăn nhé’ thường xuyên hơn.\nChúng con sẽ trở thành đôi vợ chồng luôn sống bằng hai chữ ‘chúng ta’ 💑✨"
        }
      ],
      "images": [
        "",
        ""
      ]
    },
