    "timeline": {
      "list": [
        {
          "id": "1",
          "date": "시작",
          "title": "Mối duyên bắt đầu lặng lẽ",
          "imagePath": "/templates/3b6728a2-bb39-4331-82f6-410eca19f9db/images/Z1ZXZklWR2Radl8xNzg5MjQ1MTk2X3Z5dQ.png",
          "description": "Không cần một duyên cớ đặc biệt,\nchúng tôi đã trò chuyện thật tự nhiên,\nvà cứ thế mà biết đến nhau."
        },
        {
          "id": "2",
          "date": "익숙함",
          "title": "Thời gian tiếp nối một cách tự nhiên",
          "imagePath": "/templates/3b6728a2-bb39-4331-82f6-410eca19f9db/images/d3VoaXJPT0lYQV8xNzg5MjQ1MjA4XzEydg.png",
          "description": "Không cần những lời bày tỏ đặc biệt,\nchúng tôi dần len vào đời nhau,\nvà mối quan hệ cứ thế tiếp nối thật tự nhiên."
        },
        {
          "id": "3",
          "date": "확신",
          "title": "Lựa chọn mang tên ‘cùng nhau’",
          "imagePath": "/templates/3b6728a2-bb39-4331-82f6-410eca19f9db/images/T3BLWHhtSXhpcF8xNzg5MjQ1MTkwXzdwcQ.png",
          "description": "Đi qua thật nhiều khoảnh khắc,\ntôi cảm nhận rằng thời gian bên người này\nlà điều tự nhiên nhất."
        }
      ],
      "type": "v3",
      "title": "Từ gặp gỡ đến yêu thương",
      "enabled": true,
      "subtitle": "Những khoảnh khắc làm nên chúng ta",
      "coverImage": "/templates/3b6728a2-bb39-4331-82f6-410eca19f9db/images/MExyd3RZTXFjNF8xNzg5MjQ1MTc1X3Blcg.png"
    },
    "interview": {
      "enabled": true,
      "title": "Câu chuyện của hai chúng tôi",
      "description": "Trước thềm hôn lễ, chúng tôi đã chuẩn bị\nbuổi phỏng vấn của hai chúng tôi.",
      "items": [
        {
          "id": "1",
          "title": "Q1. Hãy giới thiệu về chú rể và cô dâu",
          "description": "👦 Chú rể Kim Jin-ho (ISTJ)\nLà người lên kế hoạch kỹ càng, không giỏi bày tỏ cảm xúc nhưng chân thành sâu sắc.\nNhững lời hứa nhỏ anh đều không quên, và cả những lời than vãn mà tôi cứ ngỡ chỉ là độc thoại của mình anh cũng nhớ.\nÍt nói nên đôi khi bị hiểu lầm, nhưng anh là người âm thầm thể hiện bằng hành động.\nCâu 'người đàn ông có thể tự thay bóng đèn hỏng' có lẽ là sinh ra để dành cho Jin-ho? 😎\nVới cô dâu, anh luôn là người đàn ông vững chãi, câu nào cũng kết thúc bằng 'Ừ~' 💪🤍\n\n👰 Cô dâu Lee Na-eun (ENFP)\nLà một cỗ máy cảm xúc, ngày nào cũng cười khóc ríu rít cả chục lần 🚀\nCô dùng sự hài hước và năng lượng để thắp sáng không khí, và có thể trò chuyện về cuộc đời ngay cả với người mới gặp.\nĐó cũng là lý do cô hợp với Jin-ho, người luôn nghiêm túc đáp lại những lời độc thoại của cô.\nCô thích những chuyến đi ngẫu hứng, nhưng điều quan trọng nhất là luôn trở về nhà an toàn!\nLà người vừa lãng mạn vừa thực tế, hôm nay cũng khiến Jin-ho bật cười, một người đáng yêu và mạnh mẽ 🌸😌"
        },
        {
          "id": "2",
          "title": "Q2. Hai anh chị đã gặp nhau như thế nào?",
          "description": "Vào một ngày mà chúng tôi còn chưa biết tên nhau, hai người đã ngồi đối diện nhau trong buổi gặp mặt của những người quen.\nGiữa rất nhiều người, cuối cùng chỉ còn lại hai người.\nCuộc trò chuyện giữa Jin-ho ít nói và Na-eun hoạt ngôn có chút ngượng ngùng,\nnhưng khoảng thời gian ấy lại lạ lùng thay, rất thoải mái, và rồi chúng tôi tự nhiên liên lạc với nhau.\nBan đầu tôi chỉ nghĩ anh là một người tốt, nhưng vào một khoảnh khắc nào đó,\ntôi chợt nghĩ: 'Ước gì là người này.'\nBây giờ nghĩ lại, không khí của ngày hôm ấy… có phải chính là duyên phận? 🍀🌙"
        },
        {
          "id": "3",
          "title": "Q3. Điều gì khiến hai anh chị quyết định kết hôn?",
          "description": "Khi yêu một người lâu dài, người ta cũng có thể dần trở nên nguội lạnh vì quá quen thuộc.\nNhưng chúng tôi thì ngược lại. Càng theo thời gian, cả hai càng trở thành những người tốt hơn.\nĐôi khi cũng có cãi vã, nhưng cuối cùng chúng tôi vẫn cùng ăn cơm, cùng cười và khép lại một ngày.\nTôi cảm nhận được rằng chúng tôi đã trở thành người bạn thoải mái nhất và cũng là gia đình của nhau.\nRồi một ngày, không cần một sự kiện hoành tráng nào,\ngiữa cuộc sống thường nhật, chúng tôi ôm chặt lấy nhau và nói:\n'Mình cứ sống cùng nhau nhé?'\nĐó chính là lời cầu hôn thật sự của chúng tôi 💍"
        },
        {
          "id": "4",
          "title": "Q4. Lời hứa cho cuộc sống hôn nhân sắp tới của hai anh chị là gì?",
          "description": "Vì chúng ta có nhiều điểm giống nhau, cũng nhiều điểm khác nhau,\nnên mỗi ngày sẽ là một hành trình học hỏi và thấu hiểu lẫn nhau,\nnhưng khi giận nhau, chúng ta sẽ không chiến tranh lạnh mà hòa giải ngay,\nvà đôi khi muốn cùng nhau trải qua những ngày rung động như hẹn hò.\nNgày vui ta chia sẻ, ngày buồn ta cùng nhau san sẻ.\nViệc nhà sẽ được quyết định công bằng bằng ‘kéo ✌️ búa ✊ bao ✋’,\nvà thay vì băn khoăn ‘hôm nay ai nấu cơm’, chúng ta sẽ nói ‘mình cùng ăn nhé’ thường xuyên hơn.\nChúng ta sẽ mãi là một cặp vợ chồng sống với nhau bằng hai chữ ‘chúng ta’ 💑✨"
        }
      ],
      "images": [
        "",
        ""
      ]
    },
    "mainScreen": {
