    "timeline": {
      "list": [
        {
          "id": "1",
          "date": "2024-10-26",
          "title": "Những ngày bỗng dưng thấy nhớ nhiều hơn",
          "imagePath": "/templates/327261ec-0cc6-42ca-a60d-932980dbdd82/images/eXRnN1RxZlhwWl8xNzg5MjQwOTMxXzlxdg.png",
          "description": "Người mà tôi bỗng nhớ đến không lý do,\nvà chỉ muốn gặp thêm một lần nữa.\nCó lẽ mọi chuyện đã bắt đầu từ khi ấy."
        },
        {
          "id": "2",
          "date": "2025-03-08",
          "title": "Không biết tự khi nào",
          "imagePath": "/templates/327261ec-0cc6-42ca-a60d-932980dbdd82/images/RHpmemJlZ3UwTF8xNzg5MjQwOTA4X3A3dg.png",
          "description": "Từ một khoảnh khắc nào đó,\nchúng tôi trở thành điều hiển nhiên của nhau,\nvà tình yêu cứ thế tự nhiên bắt đầu."
        },
        {
          "id": "3",
          "date": "2025-07-26",
          "title": "Ở bên nhau là điều thoải mái nhất",
          "imagePath": "/templates/327261ec-0cc6-42ca-a60d-932980dbdd82/images/a3A3b0V5ZXF5Sl8xNzg5MjQwOTI0X24yYg.png",
          "description": "Dù không có kế hoạch đặc biệt gì,\nthời gian ở bên nhau là điều tuyệt nhất,\nvà đó cũng là lúc bình yên nhất."
        },
        {
          "id": "4",
          "date": "2026-01-03",
          "title": "Và thế là chúng tôi đã quyết định sẽ cùng nhau chung sống.",
          "imagePath": "/templates/327261ec-0cc6-42ca-a60d-932980dbdd82/images/VDlUUGNxSTNBM18xNzg5MjQwOTE0X2tyNA.png",
          "description": "Chúng tôi sẽ cùng nhau đi qua những ngày tháng phía trước\nmột cách thoải mái như hiện tại.\nHai chúng tôi, kết hôn."
        }
      ],
      "type": "v1",
      "title": "Từ gặp gỡ đến yêu thương",
      "enabled": false,
      "subtitle": "Những khoảnh khắc tạo nên chúng ta",
      "coverImage": "/templates/327261ec-0cc6-42ca-a60d-932980dbdd82/images/NnhJZ3hUa3ZUR18xNzg5MjQwOTA2XzVwMg.png"
    },
    "interview": {
      "enabled": true,
      "title": "Câu chuyện của hai chúng ta",
      "description": "Trước thềm hôn lễ, chúng con đã chuẩn bị\nbuổi phỏng vấn của hai chúng con.",
      "items": [
        {
          "id": "1",
          "title": "Q1. Hãy giới thiệu về chú rể và cô dâu.",
          "description": "👦 Chú rể\nLà người lên kế hoạch tỉ mỉ, không giỏi bày tỏ cảm xúc nhưng tình cảm sâu đậm.\nAnh không quên những lời hứa nhỏ nhặt, và cả những lời cằn nhằn mà tôi tưởng chỉ là nói một mình anh cũng nhớ.\nVì ít nói nên đôi khi bị hiểu lầm, nhưng anh là người luôn âm thầm thể hiện bằng hành động.\nCâu nói ‘người đàn ông tự thay bóng đèn hỏng’ có lẽ là dành cho Em thì phải? 😎\nVới cô dâu, anh luôn là người đàn ông vững chãi kết thúc câu bằng \"Ừ~\" 💪🤍\n\n👰 Cô dâu\nLà cỗ máy cảm xúc, ngày nào cũng cười khóc ríu rít mười hai lần 🚀\nCô ấy thắp sáng bầu không khí bằng sự hài hước và năng lượng, và có thể chia sẻ chuyện đời ngay cả với người mới gặp.\nĐó là lý do cô ấy hợp với anh ấy, người luôn nghiêm túc trả lời những lời nói một mình.\nThích du lịch tự túc nhưng điều quan trọng là luôn trở về nhà an toàn!\nLà người vừa lãng mạn vừa thực tế, hôm nay cũng khiến cười, một người dễ thương và mạnh mẽ 🌸😌"
        },
        {
          "id": "2",
          "title": "Q2. Hai bạn đã gặp nhau như thế nào?",
          "description": "Vào một ngày mà chúng tôi còn chưa biết tên nhau, chúng tôi đã ngồi đối diện trong buổi gặp mặt của người quen.\nHai người là những người ở lại đến cuối cùng trong số rất nhiều người.\nCuộc trò chuyện giữa Jin-ho ít nói và Na-eun hoạt ngôn có chút ngượng ngùng,\nnhưng khoảng thời gian đó lại thoải mái một cách lạ thường, và chúng tôi tự nhiên giữ liên lạc.\nBan đầu tôi chỉ nghĩ anh ấy là một người tốt, nhưng vào một khoảnh khắc nào đó,\ntôi đã nghĩ \"Chỉ cần là người này\".\nBây giờ nghĩ lại, bầu không khí ngày hôm đó… có phải là định mệnh không? 🍀🌙"
        },
        {
          "id": "3",
          "title": "Q3. Lý do hai bạn quyết định kết hôn là gì?",
          "description": "Khi yêu một người lâu dài, đôi khi ta trở nên chai sạn vì sự quen thuộc.\nNhưng chúng tôi thì ngược lại. Càng theo thời gian, chúng tôi càng trở thành những người tốt hơn.\nChúng tôi cũng có những lần cãi vã, nhưng cuối cùng vẫn cùng nhau ăn cơm, cười đùa và kết thúc một ngày\nvà tôi cảm nhận được rằng chúng tôi đã trở thành người bạn thoải mái nhất và cũng là gia đình của nhau.\nRồi một ngày, không cần một sự kiện hoành tráng nào,\ntrong cuộc sống thường ngày, chúng tôi ôm chặt lấy nhau và nói:\n\"Chúng ta, sống chung nhé?\"\nĐó chính là lời cầu hôn thật sự của chúng tôi 💍"
        },
        {
          "id": "4",
          "title": "Q4. Lời hứa cho cuộc sống hôn nhân sắp tới là gì?",
          "description": "Vì chúng ta có nhiều điểm giống nhau, cũng lắm điểm khác biệt\nnên mỗi ngày sẽ là một hành trình học hỏi và thấu hiểu nhau,\nnhưng khi giận nhau, chúng ta sẽ không chiến tranh lạnh mà hòa giải ngay\nvà đôi khi muốn có những ngày thật rung động như đang hẹn hò.\nNgày vui mình chia sẻ, ngày buồn mình cùng nhau san sẻ.\nViệc nhà sẽ được quyết định công bằng bằng ‘kéo✌️búa✊bao✋’,\nthay vì băn khoăn ‘ai nấu cơm’, chúng ta sẽ nói ‘cùng ăn nhé’ thường xuyên hơn.\nChúng ta sẽ luôn là vợ chồng sống với nhau bằng hai chữ ‘chúng ta’ 💑✨"
        }
      ],
      "images": [
        "/templates/327261ec-0cc6-42ca-a60d-932980dbdd82/images/elNzY210UzJHcF8xNzg5MjQwOTI4X294ZQ.png?crop=0,12,871,1550",
