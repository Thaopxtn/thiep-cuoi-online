    "timeline": {
      "list": [
        {
          "id": "1",
          "date": "시작",
          "title": "Chúng tôi gặp nhau mà không chút nghĩ suy",
          "imagePath": "/templates/b546553f-34a8-4313-a259-a79933725b70/images/ejd4ZUhxSEg3Zl8xNzg5MjQ0NzI4XzgwcQ.jpg",
          "description": "Chúng tôi gặp nhau mà không kỳ vọng nhiều,\nnhưng cuộc trò chuyện lại tiếp nối dễ dàng hơn mong đợi,\nvà đó chính là khởi đầu."
        },
        {
          "id": "2",
          "date": "연애",
          "title": "Rồi cứ thế, chúng tôi đã yêu nhau",
          "imagePath": "/templates/b546553f-34a8-4313-a259-a79933725b70/images/ZzRUU1FzQlh2aF8xNzg5MjQ0NzI3X3V2dA.png",
          "description": "Cứ gặp nhau thường xuyên,\nđến một lúc nào đó,\nchúng tôi đã tự nhiên trở thành một đôi."
        },
        {
          "id": "3",
          "date": "일상",
          "title": "Ở bên nhau là điều bình yên nhất",
          "imagePath": "/templates/b546553f-34a8-4313-a259-a79933725b70/images/cFZrU09Ld0JDVV8xNzg5MjQ0NzMwX2JtbA.png",
          "description": "Dù không làm điều gì đặc biệt,\nđược ở bên nhau là điều thoải mái nhất,\nvà điều đó cứ thế tiếp nối."
        },
        {
          "id": "4",
          "date": "확신",
          "title": "Chỉ đơn giản là người này.",
          "imagePath": "/templates/b546553f-34a8-4313-a259-a79933725b70/images/V1VaNTVXaE8xZV8xNzg5MjQ0NzE1X3o0Ng.png",
          "description": "Như bây giờ, thật thoải mái,\nchúng tôi dự định sẽ cùng nhau bước tiếp.\nHai chúng tôi, kết hôn."
        }
      ],
      "type": "v3",
      "title": "Từ gặp gỡ đến yêu thương",
      "enabled": true,
      "subtitle": "Những khoảnh khắc tạo nên chúng ta",
      "coverImage": ""
    },
    "interview": {
      "enabled": true,
      "title": "Câu chuyện của hai chúng tôi",
      "description": "Trước ngày cưới, chúng mình đã chuẩn bị phần phỏng vấn nhỏ để chia sẻ câu chuyện của hai người.",
      "items": [
        {
          "id": "1",
          "title": "Q1. Hãy giới thiệu chú rể và cô dâu",
          "description": "👦 Chú rể Kim Jin-ho (ISTJ)\nLà người lên kế hoạch chu toàn, không khéo thể hiện cảm xúc nhưng tình cảm lại sâu đậm.\nAnh không quên những lời hứa nhỏ, và cả những lời càu nhàu tưởng như tôi chỉ nói một mình cũng ghi nhớ.\nVì ít nói nên đôi khi bị hiểu lầm, nhưng anh là người lặng lẽ thể hiện bằng hành động.\nCâu nói ‘người đàn ông tự thay cả bóng đèn hỏng’ có lẽ sinh ra là để dành cho Jin-ho nhỉ? 😎\nVới cô dâu, anh luôn là người đàn ông vững chãi, kết thúc mọi chuyện bằng câu \"Ừ~\" 💪🤍\n\n👰 Cô dâu Lee Na-eun (ENFP)\nLà một cỗ máy cảm xúc, ngày nào cũng cười, khóc và ríu rít cả chục lần 🚀\nNhờ sự hài hước và năng lượng, cô ấy thắp sáng bầu không khí, và dù mới gặp lần đầu cũng có thể chia sẻ chuyện đời.\nĐó là lý do cô ấy rất hợp với Jin-ho, người luôn nghiêm túc đáp lại những lời nói một mình.\nThích những chuyến đi ngẫu hứng, nhưng điều quan trọng là luôn trở về nhà an toàn!\nLà người con gái đáng yêu mà kiên định, khi thì lãng mạn khi thì thực tế, và hôm nay vẫn khiến Jin-ho mỉm cười 🌸😌"
        },
        {
          "id": "2",
          "title": "Q2. Hai người đã gặp nhau như thế nào?",
          "description": "Vào một ngày mà chúng tôi còn chưa biết tên nhau, chúng tôi đã ngồi đối diện nhau trong buổi gặp gỡ của người quen.\nGiữa bao nhiêu người, chúng tôi là hai người ở lại đến cuối cùng.\nCuộc trò chuyện giữa Jin-ho ít nói và Na-eun lắm lời có chút ngượng ngùng,\nnhưng khoảng thời gian đó lại lạ kỳ thoải mái, và chúng tôi cứ thế tự nhiên liên lạc với nhau.\nBan đầu, tôi chỉ nghĩ đó là một người tốt, nhưng đến một khoảnh khắc,\ntôi chợt nghĩ: \"Nếu là người này thì thật tốt\".\nNghĩ lại bây giờ, bầu không khí ngày hôm ấy… có phải chính là định mệnh không? 🍀🌙"
        },
        {
          "id": "3",
          "title": "Q3. Điều gì đã khiến hai bạn quyết định kết hôn?",
          "description": "Khi ở bên một người lâu, người ta cũng có thể dần chai sạn vì quá quen thuộc.\nNhưng chúng tôi thì ngược lại. Càng theo thời gian, chúng tôi càng trở thành những người tốt hơn.\nChúng tôi cũng từng cãi vã, nhưng cuối cùng vẫn cùng nhau ăn cơm, cười đùa và khép lại một ngày,\nvà tôi nhận ra chúng tôi đã trở thành người bạn thoải mái nhất, cũng là gia đình của nhau.\nRồi một ngày, không có một sự kiện hoành tráng nào,\ngiữa cuộc sống bình thường, chúng tôi ôm chặt lấy nhau và nói:\n\"Hay là mình cứ sống cùng nhau nhé?\"\nĐó chính là lời cầu hôn thật sự của chúng tôi 💍"
        },
        {
          "id": "4",
          "title": "Q4. Hai bạn có lời hứa nào cho cuộc sống hôn nhân sắp tới?",
          "description": "Vì chúng tôi có nhiều điểm giống nhau, cũng không ít điểm khác biệt,\nnên mỗi ngày sẽ là một quá trình học hỏi và thấu hiểu nhau,\nnhưng khi cãi nhau, chúng tôi sẽ không chiến tranh lạnh mà hòa giải ngay,\nvà đôi khi muốn có những ngày rung động như đang hẹn hò.\nNgày vui sẽ cùng chia sẻ, ngày buồn sẽ cùng san sẻ.\nViệc nhà sẽ được phân công công bằng bằng ‘kéo✌️búa✊bao✋’,\nthay vì băn khoăn ‘hôm nay ai nấu cơm’, chúng tôi sẽ nói ‘cùng ăn nhé’ nhiều hơn.\nChúng tôi sẽ trở thành một cặp vợ chồng luôn sống với hai chữ ‘chúng ta’ 💑✨"
        }
      ],
      "images": [
