    "timeline": {
      "list": [
        {
          "id": "1",
          "date": "2024",
          "title": "Những ngày bỗng dưng cười nhiều hơn",
          "imagePath": "/templates/5592f05c-7056-4ce7-9003-92e2454dadde/images/STV1QnJnQTNacV8xNzg5MjQ0Mzk0X3JpMg.jpg",
          "description": "Khi ở bên nhau, tâm trạng bỗng trở nên vui vẻ chẳng vì lý do gì,\nngay cả trong những khoảnh khắc nhỏ bé,\nchúng ta đã không ngừng mỉm cười."
        },
        {
          "id": "2",
          "date": "2024",
          "title": "Thời gian thấm vào nhau thật tự nhiên",
          "imagePath": "/templates/5592f05c-7056-4ce7-9003-92e2454dadde/images/Tk1qN2dTSkdkbl8xNzg5MjQ0NDAzX3RqeA.png",
          "description": "Từ một khoảnh khắc nào đó,\nchúng ta đã tự nhiên len vào cuộc sống thường ngày của nhau,\nvà thời gian ở bên nhau ngày càng nhiều hơn."
        },
        {
          "id": "3",
          "date": "2025",
          "title": "Được ở bên nhau là điều thoải mái nhất",
          "imagePath": "/templates/5592f05c-7056-4ce7-9003-92e2454dadde/images/SzlaVDltelBTd18xNzg5MjQ0NDAzXzdhNw.png",
          "description": "Dù không có kế hoạch gì đặc biệt,\nthời gian được ở bên nhau vẫn là điều tuyệt nhất,\nvà điều đó đã trở thành cuộc sống thường ngày của chúng ta."
        },
        {
          "id": "4",
          "date": "2025",
          "title": "Nếu được ở bên người này",
          "imagePath": "/templates/5592f05c-7056-4ce7-9003-92e2454dadde/images/QVdrT29lZ3FEVl8xNzg5MjQ0Mzg5X2hweg.jpg",
          "description": "Trải qua thật nhiều khoảnh khắc,\nchỉ cần được cùng người này,\nlòng đã thấy an tâm rằng mọi chuyện sẽ ổn."
        }
      ],
      "type": "v1",
      "title": "Từ gặp gỡ đến yêu thương",
      "enabled": false,
      "subtitle": "Những khoảnh khắc làm nên chúng ta",
      "coverImage": "/templates/5592f05c-7056-4ce7-9003-92e2454dadde/images/YnhnNkQ5bHBaeF8xNzg5MjQ0NDAzX2tmaQ.png"
    },
    "interview": {
      "enabled": false,
      "title": "Câu chuyện của hai chúng tôi",
      "description": "Trước thềm hôn lễ, chúng tôi đã chuẩn bị\nbuổi phỏng vấn của hai chúng tôi.",
      "items": [
        {
          "id": "1",
          "title": "Q1. Hãy giới thiệu chú rể và cô dâu.",
          "description": "👦 Chú rể Kim Jin-ho (ISTJ)\nLà người lên kế hoạch chu đáo, không khéo bộc lộ cảm xúc nhưng chân thành sâu sắc.\nAnh không quên những lời hứa nhỏ, luôn chu toàn, và còn nhớ cả những lời than vãn mà tôi tưởng mình chỉ nói một mình.\nVì ít nói nên đôi khi bị hiểu lầm, nhưng anh là kiểu người lặng lẽ thể hiện bằng hành động.\nCâu nói 'người đàn ông tự thay cả bóng đèn hỏng' có lẽ sinh ra là dành cho Jin-ho, phải không? 😎\nVới cô dâu, anh luôn là người đàn ông vững chãi, kết thúc mọi chuyện bằng \"Ừ nhé~\" 💪🤍\n\n👰 Cô dâu Lee Na-eun (ENFP)\nLà một cỗ máy cảm xúc khi trong một ngày có thể cười, khóc, ríu rít đến mười hai lần 🚀\nCô thắp sáng bầu không khí bằng sự hài hước và năng lượng, và có thể chia sẻ chuyện đời ngay cả với người mới gặp.\nĐó cũng là lý do cô rất hợp với Jin-ho, người luôn nghiêm túc đáp lại những lời tự nói một mình.\nCô thích những chuyến đi ngẫu hứng, nhưng điều quan trọng là luôn trở về nhà an toàn!\nLà người vừa lãng mạn vừa thực tế, hôm nay cũng khiến Jin-ho bật cười, vừa dễ thương vừa kiên cường 🌸😌"
        },
        {
          "id": "2",
          "title": "Q2. Hai người đã gặp nhau như thế nào?",
          "description": "Vào một ngày khi còn chưa biết tên nhau, chúng tôi đã ngồi đối diện nhau trong một buổi tụ tập của người quen.\nGiữa bao nhiêu người, chúng tôi là hai người ở lại đến cuối cùng.\nCuộc trò chuyện giữa Jin-ho ít nói và Na-eun lắm lời có chút ngượng ngùng,\nnhưng khoảng thời gian ấy lại lạ lùng thoải mái, và chúng tôi cứ thế tự nhiên giữ liên lạc.\nBan đầu, tôi chỉ nghĩ đó là một người tốt, nhưng đến một khoảnh khắc,\ntôi chợt nghĩ: \"Nếu là người này thì tốt biết mấy.\"\nNghĩ lại bây giờ, bầu không khí của ngày hôm ấy… phải chăng chính là định mệnh? 🍀🌙"
        },
        {
          "id": "3",
          "title": "Q3. Cơ duyên nào đã khiến hai người quyết định kết hôn?",
          "description": "Khi yêu một người đủ lâu, người ta cũng có thể trở nên chai sạn vì quá quen thuộc.\nNhưng chúng tôi thì ngược lại. Càng theo thời gian, chúng tôi càng trở thành những người tốt hơn.\nChúng tôi cũng từng cãi vã, nhưng cuối cùng vẫn cùng nhau ăn cơm, cười đùa và khép lại một ngày,\nvà tôi nhận ra chúng tôi đã trở thành người bạn thoải mái nhất, cũng như gia đình của nhau.\nRồi một ngày, không cần một sự kiện hoành tráng nào,\ngiữa cuộc sống thường nhật, chúng tôi ôm chặt lấy nhau và nói:\n\"Chúng ta cứ sống cùng nhau nhé?\"\nĐó chính là lời cầu hôn thật sự của chúng tôi 💍"
        },
        {
          "id": "4",
          "title": "Q4. Lời hứa cho cuộc sống hôn nhân sắp tới là gì?",
          "description": "Vì chúng con có nhiều điểm giống nhau, cũng nhiều điểm khác biệt\nnên mỗi ngày sẽ là một quá trình học hỏi và thấu hiểu,\nnhưng khi cãi nhau, chúng con sẽ không chiến tranh lạnh mà hòa giải ngay\nvà đôi khi muốn có những ngày xốn xang như đang hẹn hò.\nNgày vui chúng con chia sẻ, ngày buồn chúng con cùng nhau san sẻ.\nViệc nhà sẽ được phân định công bằng bằng ‘oẳn tù tì ✌️✊✋’,\nthay vì băn khoăn ‘ai nấu cơm nhỉ’, chúng con sẽ nói ‘cùng ăn nhé’ nhiều hơn.\nChúng con sẽ trở thành một cặp vợ chồng luôn sống với hai chữ ‘chúng ta’ 💑✨"
        }
      ],
      "images": [
        "",
        ""
      ]
    },
