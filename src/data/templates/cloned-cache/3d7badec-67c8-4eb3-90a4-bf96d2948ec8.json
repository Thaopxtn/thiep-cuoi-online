    "timeline": {
      "list": [
        {
          "id": "1",
          "date": "2024-04-20",
          "title": "Chúng ta bắt đầu như mùa xuân",
          "imagePath": "/templates/3d7badec-67c8-4eb3-90a4-bf96d2948ec8/images/dnNKQVk3Q292SV8xNzg5MjQ1MzE1X2xlOQ.png",
          "description": "Tựa như tiết trời dần ấm,\nnhững câu chuyện của đôi ta cũng tự nhiên tiếp nối,\nvà chúng ta đã bắt đầu như vậy."
        },
        {
          "id": "2",
          "date": "2024-06-07",
          "title": "Những ngày bỗng dưng cười nhiều hơn",
          "imagePath": "/templates/3d7badec-67c8-4eb3-90a4-bf96d2948ec8/images/VzVZQWtwZms5aF8xNzg5MjQ1Mjk4X2xrOQ.png",
          "description": "Một thời, không cần lý do cũng thấy lòng vui hơn,\nngay cả những khoảnh khắc nhỏ nhặt cũng khiến ta bật cười.\nKhi ấy, chúng ta đã xao xuyến biết bao."
        },
        {
          "id": "3",
          "date": "2025-08-22",
          "title": "Nếu là cùng người ấy",
          "imagePath": "/templates/3d7badec-67c8-4eb3-90a4-bf96d2948ec8/images/Vk00eFRYYmx6S18xNzg5MjQ1MjkxX2Q2MA.png",
          "description": "Chợt tôi nhận ra một điều.\nDẫu mùa này có qua đi,\nngười tôi vẫn muốn mãi cùng đồng hành."
        },
        {
          "id": "4",
          "date": "2026-10-24",
          "title": "Từ đây, chúng ta sẽ cùng nhau đi qua những mùa.",
          "imagePath": "/templates/3d7badec-67c8-4eb3-90a4-bf96d2948ec8/images/YTZoOWhYdkRxdl8xNzg5MjQ1MzA1XzRtNw.png",
          "description": "Mối duyên khởi đầu như mùa xuân,\nđậm sâu tựa mùa hạ,\nhai chúng tôi kết hôn."
        }
      ],
      "type": "v2",
      "title": "Từ gặp gỡ đến yêu thương",
      "enabled": false,
      "subtitle": "Những khoảnh khắc làm nên chúng ta",
      "coverImage": "/templates/3d7badec-67c8-4eb3-90a4-bf96d2948ec8/images/WXB3NU83MW9INV8xNzg5MjQ1MzA1XzUzZw.png"
    },
    "interview": {
      "enabled": false,
      "title": "Câu chuyện của hai chúng tôi",
      "description": "Trước thềm hôn lễ, chúng tôi đã chuẩn bị\nbuổi phỏng vấn của hai chúng tôi.",
      "items": [
        {
          "id": "1",
          "title": "Q1. Hãy giới thiệu chú rể và cô dâu.",
          "description": "👦 chú rể Kim Jin-ho (ISTJ)\nLà người lập kế hoạch chu toàn, không khéo bày tỏ cảm xúc nhưng tình cảm sâu đậm.\nNhững lời hứa nhỏ cũng không quên, luôn để tâm chu toàn, và ngay cả những lời than vãn tưởng như tôi chỉ nói một mình, anh ấy cũng ghi nhớ.\nVì ít nói nên đôi khi bị hiểu lầm, nhưng anh ấy là kiểu người lặng lẽ thể hiện bằng hành động.\nCâu nói ‘người đàn ông tự thay bóng đèn hỏng’ có lẽ sinh ra là dành cho Jin-ho, phải không ạ? 😎\nVới cô dâu, anh ấy luôn là người đàn ông vững chãi, kết thúc mọi câu bằng “Ừ~” 💪🤍\n\n👰 cô dâu Lee Na-eun (ENFP)\nCô ấy là một cỗ máy cảm xúc, ngày nào cũng cười, khóc và ríu rít không ngừng 🚀\nVới khiếu hài hước và nguồn năng lượng dồi dào, cô ấy thắp sáng bầu không khí, và dù mới gặp lần đầu cũng có thể chia sẻ chuyện đời.\nĐó là lý do cô ấy rất hợp với Jin-ho, người luôn nghiêm túc trả lời cả những câu nói một mình.\nThích những chuyến đi ngẫu hứng, nhưng điều quan trọng là luôn trở về nhà an toàn!\nLà người vừa lãng mạn vừa thực tế, hôm nay vẫn khiến Jin-ho mỉm cười, một người vừa đáng yêu vừa mạnh mẽ 🌸😌"
        },
        {
          "id": "2",
          "title": "Q2. Hai anh chị đã gặp nhau như thế nào?",
          "description": "Vào một ngày khi cả hai còn chưa biết tên nhau, chúng tôi đã ngồi đối diện nhau trong buổi gặp gỡ của một người quen.\nGiữa rất nhiều người, chỉ hai người là ở lại đến cuối cùng.\nCuộc trò chuyện giữa Jin-ho ít nói và Na-eun nói nhiều có chút ngượng ngùng,\nnhưng khoảng thời gian ấy lại lạ kỳ dễ chịu, và chúng tôi cứ thế tự nhiên liên lạc với nhau.\nBan đầu, tôi chỉ nghĩ đó là một người tốt, nhưng đến một khoảnh khắc,\ntôi chợt nghĩ: “Nếu là người này thì tốt biết mấy.”\nNghĩ lại bây giờ, bầu không khí ngày hôm ấy… có phải là duyên mệnh không? 🍀🌙"
        },
        {
          "id": "3",
          "title": "Q3. Điều gì đã khiến hai anh chị quyết định kết hôn?",
          "description": "Khi yêu một người lâu, người ta thường dễ trở nên quen thuộc đến mức vô cảm.\nNhưng chúng tôi thì ngược lại. Càng theo thời gian, chúng tôi càng trở thành những người tốt hơn dành cho nhau.\nĐôi khi cũng có cãi vã, nhưng cuối cùng chúng tôi vẫn cùng ăn cơm, cười đùa và kết thúc một ngày bên nhau,\nvà tôi nhận ra rằng chúng tôi đã trở thành người bạn thoải mái nhất, và cũng là gia đình của nhau.\nRồi một ngày, không có sự kiện gì hoành tráng,\ngiữa cuộc sống thường nhật, chúng tôi ôm chặt lấy nhau và nói:\n“Hay là mình cứ sống cùng nhau nhé?”\nĐó chính là lời cầu hôn thật sự của chúng tôi 💍"
        },
        {
          "id": "4",
          "title": "Q4. Hai anh chị có lời hứa nào cho cuộc sống hôn nhân sắp tới?",
          "description": "Chúng con có nhiều điểm giống nhau, cũng có nhiều điểm khác biệt,\nNên mỗi ngày sẽ là một quá trình học hỏi và thấu hiểu lẫn nhau,\nKhi giận nhau, chúng con sẽ không chiến tranh lạnh mà hòa giải ngay,\nĐôi khi mong được sống những ngày rung động như thuở hẹn hò.\nNgày vui mình chia sẻ, ngày buồn mình cùng nhau san sẻ.\nViệc nhà sẽ được quyết định công bằng bằng ‘oẳn tù tì✌️✊✋’,\nThay vì băn khoăn ‘ai sẽ nấu cơm’, chúng con sẽ nói ‘mình ăn cùng nhau’ thường xuyên hơn.\nChúng con sẽ luôn là một cặp vợ chồng sống với nhau bằng hai chữ ‘chúng ta’ 💑✨"
        }
      ],
      "images": [
        "",
        ""
      ]
    },
