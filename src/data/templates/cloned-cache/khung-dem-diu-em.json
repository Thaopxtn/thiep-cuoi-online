    "timeline": {
      "list": [
        {
          "id": "1",
          "date": "시작",
          "title": "Chúng ta đã gặp nhau vào lúc ngày dần khép lại",
          "imagePath": "/templates/cbb0cfb6-a823-4966-abed-9fb9aee38610/images/OG5TZ01kM0RzVV8xNzg5MjQ0MDM3XzUzZw.png",
          "description": "Một buổi chiều nhuốm sắc ấm áp,\nnhững câu chuyện trao nhau thật tự nhiên\nđã trở thành khởi đầu của một mối duyên."
        },
        {
          "id": "2",
          "date": "가까워짐",
          "title": "Thấm vào từng ngày của nhau",
          "imagePath": "/templates/cbb0cfb6-a823-4966-abed-9fb9aee38610/images/ZmFIdU84SWtEeV8xNzg5MjQ0MDM3X2ozNw.png",
          "description": "Từ một khoảnh khắc nào đó,\nđôi ta nhẹ nhàng len vào cuộc sống của nhau,\nvà thời gian bên nhau trở nên quen thuộc."
        },
        {
          "id": "3",
          "date": "일상",
          "title": "Đã trở thành người mang lại cảm giác an yên nhất",
          "imagePath": "/templates/cbb0cfb6-a823-4966-abed-9fb9aee38610/images/V05Dd2EzcFBBbl8xNzg5MjQ0MDI3X3Y2eA.jpg",
          "description": "Hơn cả những khoảnh khắc đặc biệt,\nthời gian cùng nhau trong những ngày bình dị\nđã trở nên quý giá hơn."
        },
        {
          "id": "4",
          "date": "확신",
          "title": "Nếu được cùng người ấy",
          "imagePath": "/templates/cbb0cfb6-a823-4966-abed-9fb9aee38610/images/VFN3WGJMeU8wUF8xNzg5MjQ0MDM3X25wcQ.png",
          "description": "Trong những tháng ngày đã qua,\nchỉ cần được cùng người ấy,\ntôi đã thấy mọi điều đều ổn."
        }
      ],
      "type": "v3",
      "title": "Từ gặp gỡ đến yêu thương",
      "enabled": true,
      "subtitle": "Những khoảnh khắc làm nên chúng ta",
      "coverImage": "/templates/cbb0cfb6-a823-4966-abed-9fb9aee38610/images/ODc2QVJyVjBPMV8xNzg5MjQ0MDQ5X2NleQ.png"
    },
    "interview": {
      "enabled": true,
      "title": "Câu chuyện của hai chúng tôi",
      "description": "Trước thềm hôn lễ, chúng tôi đã chuẩn bị\nbuổi phỏng vấn của hai chúng tôi.",
      "items": [
        {
          "id": "1",
          "title": "Q1. Hãy giới thiệu chú rể và cô dâu.",
          "description": "👦 Chú rể Kim Jin-ho (ISTJ)\nLà người lên kế hoạch kỹ càng, khó bày tỏ cảm xúc nhưng tình cảm sâu đậm.\nKhông quên những lời hứa nhỏ, và ngay cả những lời cằn nhằn tưởng như tôi tự nói một mình cũng ghi nhớ.\nÍt nói nên đôi khi bị hiểu lầm, nhưng là người âm thầm thể hiện bằng hành động.\nCâu 'người đàn ông tự thay cả bóng đèn hỏng' có lẽ sinh ra là dành cho Jin-ho? 😎\nVới cô dâu, anh luôn là người đàn ông vững chãi, kết thúc câu bằng 'Ừ, được~' 💪🤍\n\n👰 Cô dâu Lee Na-eun (ENFP)\nLà cỗ máy cảm xúc khi một ngày có thể cười, khóc và ríu rít đến mười hai lần 🚀\nDùng sự hóm hỉnh và năng lượng để thắp sáng bầu không khí, dù mới gặp cũng có thể chia sẻ chuyện đời.\nĐó là lý do cô ấy rất hợp với Jin-ho, người luôn nghiêm túc đáp lại những lời tự nói một mình.\nThích những chuyến đi ngẫu hứng, nhưng điều quan trọng là luôn trở về nhà an toàn!\nLà người vừa lãng mạn vừa thực tế, hôm nay cũng khiến Jin-ho mỉm cười – một người dễ thương và mạnh mẽ 🌸😌"
        },
        {
          "id": "2",
          "title": "Q2. Hai người đã gặp nhau như thế nào?",
          "description": "Vào một ngày khi cả hai còn chưa biết tên nhau, chúng tôi đã ngồi đối diện trong buổi gặp gỡ của người quen.\nGiữa rất nhiều người, hai người là những người ở lại đến cuối cùng.\nCuộc trò chuyện giữa Jin-ho ít nói và Na-eun nói nhiều có chút ngượng ngùng,\nnhưng khoảng thời gian ấy lại lạ lùng thoải mái, và chúng tôi tự nhiên giữ liên lạc.\nBan đầu chỉ nghĩ đối phương là một người tốt, nhưng đến một khoảnh khắc,\ntôi chợt nghĩ: 'Nếu là người này thì thật tốt.'\nNghĩ lại bây giờ, bầu không khí ngày hôm ấy… phải chăng là định mệnh? 🍀🌙"
        },
        {
          "id": "3",
          "title": "Q3. Cơ duyên nào khiến hai người quyết định kết hôn?",
          "description": "Khi yêu ai đó lâu dài, người ta cũng dễ trở nên chai sạn vì quá quen thuộc.\nNhưng chúng tôi thì ngược lại. Càng theo thời gian, cả hai càng trở thành phiên bản tốt hơn.\nCũng có lúc cãi vã, nhưng cuối cùng chúng tôi vẫn cùng ăn cơm, cười đùa và kết thúc một ngày,\nvà nhận ra rằng đối phương đã trở thành người bạn thoải mái nhất, cũng như gia đình của mình.\nRồi một ngày, không có sự kiện hoành tráng nào,\ngiữa cuộc sống thường nhật, chúng tôi ôm chặt lấy nhau và nói:\n'Mình cứ sống cùng nhau nhé?'\nĐó chính là lời cầu hôn thật sự của chúng tôi 💍"
        },
        {
          "id": "4",
          "title": "Q4. Hai người có lời hứa gì cho cuộc sống hôn nhân sắp tới?",
          "description": "Vì chúng ta có nhiều điểm giống nhau, cũng nhiều điểm khác biệt\nnên mỗi ngày sẽ là một quá trình học hỏi và thấu hiểu lẫn nhau,\nnhưng khi giận nhau, chúng ta sẽ không chiến tranh lạnh mà hòa giải ngay\nvà đôi khi muốn có những ngày thật xao xuyến như đang hẹn hò.\nNgày vui thì cùng chia sẻ, ngày buồn thì cùng nhau san sẻ.\nViệc nhà sẽ được phân chia công bằng bằng ‘kéo✌️búa✊bao✋’,\nvà thay vì băn khoăn ‘hôm nay ai nấu cơm’, chúng ta sẽ nói ‘cùng ăn nhé’ nhiều hơn.\nChúng ta sẽ mãi là một cặp vợ chồng sống trong hai chữ ‘chúng ta’ 💑✨"
        }
      ],
