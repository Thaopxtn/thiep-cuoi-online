    "timeline": {
      "list": [
        {
          "id": "1",
          "date": "설렘",
          "title": "Chúng mình đã dần gần nhau hơn",
          "imagePath": "/templates/8b92bbcd-83d7-46d9-b522-8c61042b0342/images/Wjlvd3M2NGFzMl8xNzg5MjQ0ODcyX253cA.png",
          "description": "Chỉ một cuộc trò chuyện nhỏ cũng khiến chúng ta bật cười,\nKhi thời gian bên nhau dần trở nên quen thuộc,\nChúng ta đã trở thành người đặc biệt của nhau."
        },
        {
          "id": "2",
          "date": "추억",
          "title": "Những thời khắc rạng ngời hơn vì có nhau",
          "imagePath": "/templates/8b92bbcd-83d7-46d9-b522-8c61042b0342/images/b1hVTkhkUVpJZ18xNzg5MjQ0ODc3X3B1aA.png",
          "description": "Dù mùa có đổi thay, chúng ta vẫn luôn bên nhau,\nMột ngày bình thường cũng nhờ có nhau mà trở nên đặc biệt.\nNhững kỷ niệm của chúng ta dần được vun đắp."
        },
        {
          "id": "3",
          "date": "약속",
          "title": "Ngày chúng ta nguyện đồng hành trọn đời",
          "imagePath": "/templates/8b92bbcd-83d7-46d9-b522-8c61042b0342/images/NEFzNDdKcVZGNF8xNzg5MjQ0ODU1X2trdA.png",
          "description": "Với mong ước được cùng nhau\nđi qua mọi thời gian phía trước,\nchúng ta đã nắm chặt tay nhau."
        }
      ],
      "type": "v1",
      "title": "Từ gặp gỡ đến yêu thương",
      "enabled": true,
      "subtitle": "Những khoảnh khắc làm nên chúng ta",
      "coverImage": "/templates/8b92bbcd-83d7-46d9-b522-8c61042b0342/images/SHkxQU9Sb01XWV8xNzg5MjQ0ODU4Xzd4NQ.png"
    },
    "interview": {
      "enabled": false,
      "title": "Câu chuyện của hai chúng tôi",
      "description": "Trước thềm hôn lễ, chúng tôi đã chuẩn bị\nbuổi phỏng vấn của hai chúng tôi.",
      "items": [
        {
          "id": "1",
          "title": "Q1. Hãy giới thiệu chú rể và cô dâu",
          "description": "👦 Chú rể Kim Jin-ho (ISTJ)\nLà người lên kế hoạch kỹ lưỡng, bộc lộ cảm xúc thì vụng về nhưng tình cảm lại sâu đậm.\nNhững lời hứa nhỏ cũng không quên chăm chút, và ngay cả những lời càu nhàu mà tôi tưởng chỉ là tự nói với mình, anh ấy cũng nhớ.\nVì ít nói nên đôi khi bị hiểu lầm, nhưng anh ấy thuộc kiểu lặng lẽ thể hiện bằng hành động.\nCâu “người đàn ông tự thay cả bóng đèn hỏng” có lẽ sinh ra là dành cho Jin-ho chăng? 😎\nVới cô dâu, anh ấy luôn là người đàn ông vững chãi, lúc nào cũng kết thúc bằng “Ừ, được~” 💪🤍\n\n👰 Cô dâu Lee Na-eun (ENFP)\nLà một cỗ máy cảm xúc, một ngày có thể cười, khóc, ríu rít đến mười hai lần 🚀\nNhờ sự hóm hỉnh và năng lượng, cô ấy làm bừng sáng không khí, và dù mới gặp lần đầu cũng có thể chia sẻ chuyện đời.\nĐó cũng là lý do cô ấy rất hợp với Jin-ho, người luôn nghiêm túc đáp lại cả những câu nói một mình.\nThích những chuyến đi ngẫu hứng, nhưng điều quan trọng là luôn trở về nhà an toàn!\nLà người vừa lãng mạn vừa thực tế, hôm nay cũng khiến Jin-ho mỉm cười, đáng yêu và vững vàng 🌸😌"
        },
        {
          "id": "2",
          "title": "Q2. Hai người đã gặp nhau như thế nào?",
          "description": "Vào một ngày khi cả hai còn chưa biết tên nhau, chúng tôi đã ngồi đối diện trong buổi gặp gỡ của những người quen.\nGiữa bao nhiêu người, cuối cùng chỉ còn lại hai người.\nCuộc trò chuyện giữa Jin-ho ít nói và Na-eun lắm lời có chút ngượng ngùng,\nnhưng khoảng thời gian ấy lại lạ lùng thay, thật dễ chịu, và chúng tôi cứ thế nhắn tin cho nhau một cách tự nhiên.\nLúc đầu, tôi chỉ nghĩ đây là một người tốt, nhưng vào một khoảnh khắc nào đó,\ntôi chợt nghĩ: “Người này thì tốt biết mấy.”\nNghĩ lại bây giờ, bầu không khí ngày hôm ấy… phải chăng là định mệnh? 🍀🌙"
        },
        {
          "id": "3",
          "title": "Q3. Điều gì khiến hai người quyết định kết hôn?",
          "description": "Khi yêu một người lâu, người ta thường dễ trở nên chai sạn vì sự quen thuộc.\nNhưng chúng tôi thì ngược lại. Càng theo thời gian, chúng tôi càng trở thành những người tốt hơn.\nĐôi khi cũng cãi vã, nhưng cuối cùng vẫn cùng ăn cơm, cùng cười và kết thúc một ngày bên nhau,\nvà chúng tôi nhận ra mình đã trở thành người bạn thoải mái nhất, cũng như gia đình của nhau.\nRồi một ngày, không cần một sự kiện hoành tráng nào,\ngiữa cuộc sống thường nhật, chúng tôi ôm chặt lấy nhau và nói:\n“Mình cứ sống cùng nhau nhé?”\nĐó chính là lời cầu hôn thật sự của chúng tôi 💍"
        },
        {
          "id": "4",
          "title": "Q4. Hai người có lời hứa gì cho cuộc sống hôn nhân sắp tới?",
          "description": "Vì chúng mình có nhiều điểm giống nhau, cũng có không ít điều khác biệt,\nnên mỗi ngày sẽ là một quá trình học hỏi và thấu hiểu nhau,\nnhưng khi giận nhau, chúng mình sẽ không chiến tranh lạnh mà hòa giải ngay,\nđôi khi vẫn muốn có những ngày rung động như đang hẹn hò.\nNgày vui mình chia sẻ, ngày buồn mình cùng nhau san sẻ.\nViệc nhà sẽ được quyết định công bằng bằng ‘oẳn tù tì ✌️✊✋’,\nthay vì băn khoăn ‘hôm nay ai nấu cơm’, chúng mình sẽ nói ‘cùng ăn nhé’ thường xuyên hơn.\nChúng mình sẽ mãi là một cặp vợ chồng sống trong ‘chúng ta’ 💑✨"
        }
      ],
      "images": [
        "",
        ""
      ]
    },
