    "timeline": {
      "list": [
        {
          "id": "1",
          "date": "설렘",
          "title": "Những ngày bỗng dưng cười nhiều hơn",
          "imagePath": "/templates/917772d9-d56c-43ca-b671-12f7023f01ce/images/WU45dnFxeGNJdV8xNzg5MjQ1MTM2X3FlaQ.jpg",
          "description": "Người khiến lòng bỗng vui lên chẳng vì lý do gì,\nngười cứ mãi hiện lên trong tâm trí.\nCứ thế, hai trái tim dần trở nên gần nhau."
        },
        {
          "id": "2",
          "date": "일상",
          "title": "Thời gian bình dị mà càng thêm yêu",
          "imagePath": "/templates/917772d9-d56c-43ca-b671-12f7023f01ce/images/STdza3ZxSGZtQ18xNzg5MjQ1MTI2XzNtMw.jpg",
          "description": "Những ngày dù chẳng có gì đặc biệt,\nvẫn thật đẹp vì có nhau.\nCứ thế, thời gian của chúng ta dần đong đầy."
        },
        {
          "id": "3",
          "date": "확신",
          "title": "Nếu là cùng người này",
          "imagePath": "/templates/917772d9-d56c-43ca-b671-12f7023f01ce/images/bUFneVNFSlVPNV8xNzg5MjQ1MTUxX3Y3bg.png",
          "description": "Bỗng nhiên, một suy nghĩ chợt đến.\nRằng người mình muốn cùng sẻ chia mọi khoảnh khắc phía trước\nchính là người ấy."
        },
        {
          "id": "4",
          "date": "약속",
          "title": "Giờ đây, chúng ta sẽ cùng nhau bước tiếp.",
          "imagePath": "/templates/917772d9-d56c-43ca-b671-12f7023f01ce/images/QXVoTThvbjRnM18xNzg5MjQ1MTMxXzZ4aQ.png",
          "description": "Như những ngày đã qua,\nnhững ngày sắp tới chúng con cũng sẽ cùng nhau,\nvà hai chúng con xin được kết hôn."
        }
      ],
      "type": "v3",
      "title": "Từ gặp gỡ đến yêu thương",
      "enabled": true,
      "subtitle": "Những khoảnh khắc tạo nên chúng ta",
      "coverImage": "/templates/917772d9-d56c-43ca-b671-12f7023f01ce/images/WW10blh4WVBYQl8xNzg5MjQ1MTM3X2oxag.png"
    },
    "interview": {
      "enabled": true,
      "title": "Câu chuyện của hai chúng tôi",
      "description": "Trước thềm lễ cưới, chúng tôi đã chuẩn bị\nbài phỏng vấn của hai chúng tôi.",
      "items": [
        {
          "id": "1",
          "title": "Q1. Hãy giới thiệu về chú rể và cô dâu",
          "description": "👦 Chú rể Kim Jin-ho (ISTJ)\nLà người lên kế hoạch chu toàn, không giỏi bộc lộ cảm xúc nhưng có tình cảm sâu đậm.\nKhông quên những lời hứa nhỏ nhặt, và cả những lời cằn nhằn mà tôi tưởng chỉ là nói một mình cũng ghi nhớ.\nÍt nói nên đôi khi bị hiểu lầm, nhưng là kiểu người lặng lẽ thể hiện bằng hành động.\nCâu “người đàn ông có thể tự thay bóng đèn hỏng” có lẽ sinh ra là dành cho Jin-ho? 😎\nVới cô dâu, anh luôn là người đàn ông vững chãi, kết thúc mọi chuyện bằng “Ừ, được~” 💪🤍\n\n👰 Cô dâu Lee Na-eun (ENFP)\nLà cỗ máy cảm xúc khi một ngày có thể cười, khóc, ríu rít đến mười hai lần 🚀\nDùng sự hài hước và năng lượng để thắp sáng không khí, và dù mới gặp cũng có thể chia sẻ chuyện đời.\nĐó cũng là lý do cô hợp với Jin-ho, người luôn nghiêm túc trả lời cả khi cô nói một mình.\nThích những chuyến đi ngẫu hứng, nhưng điều quan trọng là luôn trở về nhà an toàn!\nLà người vừa lãng mạn vừa thực tế, hôm nay cũng khiến Jin-ho bật cười, một người dễ thương và mạnh mẽ 🌸😌"
        },
        {
          "id": "2",
          "title": "Q2. Hai người đã gặp nhau như thế nào?",
          "description": "Vào một ngày khi cả hai còn chưa biết tên nhau, chúng tôi đã ngồi đối diện nhau trong buổi gặp gỡ của những người quen.\nGiữa rất nhiều người, chúng tôi là hai người ở lại đến cuối cùng.\nCuộc trò chuyện giữa Jin-ho ít nói và Na-eun hoạt ngôn có chút ngượng ngùng,\nnhưng khoảng thời gian ấy lại lạ thường dễ chịu, và chúng tôi tự nhiên giữ liên lạc với nhau.\nBan đầu, tôi chỉ nghĩ đó là một người tốt, nhưng đến một khoảnh khắc,\ntôi chợt nghĩ: “Giá mà là người này thì tốt biết mấy.”\nNghĩ lại bây giờ, bầu không khí của ngày hôm ấy… phải chăng là định mệnh? 🍀🌙"
        },
        {
          "id": "3",
          "title": "Q3. Điều gì đã khiến hai người quyết định kết hôn?",
          "description": "Khi yêu một người lâu, người ta thường dễ trở nên chai sạn vì sự quen thuộc.\nNhưng với chúng tôi thì ngược lại. Càng thời gian trôi qua, cả hai càng trở thành những người tốt hơn.\nChúng tôi cũng từng cãi nhau, nhưng cuối cùng vẫn cùng ăn cơm, cùng cười và kết thúc một ngày bên nhau,\nvà tôi nhận ra chúng tôi đã trở thành người bạn thoải mái nhất, cũng như gia đình của nhau.\nRồi một ngày, không cần một sự kiện hoành tráng nào,\ngiữa cuộc sống thường nhật, chúng tôi ôm chặt lấy nhau và nói:\n“Hay là mình cứ sống cùng nhau nhé?”\nĐó chính là lời cầu hôn thật sự của chúng tôi 💍"
        },
        {
          "id": "4",
          "title": "Q4. Lời hứa cho cuộc sống hôn nhân sắp tới là gì?",
          "description": "Vì chúng ta có nhiều điểm giống nhau, cũng có nhiều điểm khác nhau,\nmỗi ngày sẽ là một hành trình học hỏi và thấu hiểu,\nnhưng khi giận nhau, chúng ta sẽ không chiến tranh lạnh mà hòa giải ngay,\nđôi khi muốn cùng nhau trải qua những ngày thật xao xuyến như đang hẹn hò.\nNgày vui ta sẻ chia, ngày buồn ta cùng nhau san sẻ.\nViệc nhà sẽ được phân chia công bằng bằng ‘kéo✌️búa✊bao✋’,\nthay vì băn khoăn ‘ai nấu cơm’, chúng ta sẽ nói ‘cùng ăn nhé’ nhiều hơn.\nChúng ta sẽ mãi là một cặp vợ chồng sống trong ‘chúng ta’ 💑✨"
        }
      ],
