    "timeline": {
      "list": [
        {
          "id": "1",
          "date": "31/05/2026",
          "title": "Cuộc gặp gỡ bắt đầu như một chuyến hành trình",
          "imagePath": "uploads/5af5da25-5a53-48e8-b66a-e3fc38b23dc4/SU1HMDk3MF8xNzkwOTU1ODEwMzE4XzRuZWYweHpqdXph.jpg?crop=0,0,1824,1368",
          "description": "Như thể gặp nhau ở một nơi xa lạ,\ncuộc trò chuyện bắt đầu thật nhẹ nhàng\nmà nào ngờ lại kéo dài đến vậy."
        },
        {
          "id": "2",
          "date": "연애",
          "title": "Những khoảnh khắc bên nhau đã ngày càng nhiều hơn",
          "imagePath": "/templates/1f422dc5-7795-48c4-8e1a-48cc8421dbc3/images/bWVUbjZoendLQ18xNzg5MjQ1NDM1X2hrdA.jpg",
          "description": "Thời gian bắt đầu như một chuyến đi ngắn,\nchẳng mấy chốc đã trở thành thường nhật,\nvà chúng ta tự nhiên ở bên nhau."
        },
        {
          "id": "3",
          "date": "확신",
          "title": "Nếu là cùng người này, bất cứ nơi đâu",
          "imagePath": "/templates/1f422dc5-7795-48c4-8e1a-48cc8421dbc3/images/aU5LTXF2R0x0SV8xNzg5MjQ1NDQyX3Z5aw.png",
          "description": "Dù ở nơi đâu cũng không còn quan trọng,\nchỉ cần được cùng nhau là đủ,\nvà điều đó đã trở thành niềm tin vững chắc."
        }
      ],
      "type": "v1",
      "title": "Từ gặp gỡ đến yêu thương",
      "enabled": false,
      "subtitle": "Những khoảnh khắc làm nên chúng ta",
      "coverImage": "uploads/5af5da25-5a53-48e8-b66a-e3fc38b23dc4/SU1HMDA0Ml8xNzkwOTU0ODU0MDI3Xzkyd2pkNGtrNm0.jpg?crop=190,172,1122,1496"
    },
    "interview": {
      "enabled": false,
      "title": "Câu chuyện của hai chúng tôi",
      "description": "Trước thềm hôn lễ, chúng tôi đã chuẩn bị\nbuổi phỏng vấn của hai chúng tôi.",
      "items": [
        {
          "id": "3",
          "title": "Q3. Điều gì đã khiến hai người quyết định kết hôn?",
          "description": "Khi yêu một người lâu dài, người ta cũng có thể trở nên chai sạn vì quá quen thuộc, đúng không?\nNhưng với chúng tôi thì ngược lại. Thời gian càng trôi, chúng tôi càng trở thành những người tốt hơn.\nDù cũng có lúc cãi vã, cuối cùng chúng tôi vẫn cùng nhau ăn cơm, cười đùa và khép lại một ngày\nvà tôi nhận ra rằng chúng tôi đã trở thành người bạn thoải mái nhất, cũng như gia đình của nhau.\nRồi một ngày, không cần một sự kiện hoành tráng nào,\ntrong cuộc sống thường ngày, chúng tôi ôm chặt lấy nhau và nói:\n“Hay là chúng mình sống cùng nhau nhé?”\nĐó chính là lời cầu hôn thật sự của chúng tôi 💍"
        },
        {
          "id": "4",
          "title": "Q4. Lời hứa cho cuộc sống hôn nhân sắp tới là gì?",
          "description": "Vì chúng ta có nhiều điểm giống nhau, cũng có nhiều điểm khác biệt,\nnên mỗi ngày sẽ là một quá trình học hỏi và thấu hiểu lẫn nhau,\nnhưng khi cãi nhau, chúng ta sẽ không chiến tranh lạnh mà hòa giải ngay,\nvà đôi khi muốn có những ngày xao xuyến như đang hẹn hò.\nNgày vui ta chia sẻ, ngày buồn ta cùng nhau san sẻ.\nViệc nhà sẽ được phân định công bằng bằng ‘oẳn tù tì ✌️✊✋’,\nthay vì băn khoăn ‘ai sẽ nấu cơm’, chúng ta sẽ nói ‘cùng ăn nhé’ nhiều hơn.\nChúng ta sẽ là một cặp vợ chồng luôn sống trong hai chữ ‘chúng ta’ 💑✨"
        }
      ],
      "images": [
        "/templates/1f422dc5-7795-48c4-8e1a-48cc8421dbc3/images/d0c5NHI4SHZpRl8xNzg5MjQ1NDM5X2k5cg.png?crop=0,0,878,1094",
