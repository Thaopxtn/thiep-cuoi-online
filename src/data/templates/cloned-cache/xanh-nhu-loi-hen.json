    "timeline": {
      "list": [
        {
          "id": "1",
          "date": "2024-08-22",
          "title": "Mối duyên âm thầm bắt đầu",
          "imagePath": "/templates/82f29721-5471-4784-b3f8-bee9afa7c790/images/S2Z2U09hdWZsV18xNzg5MjQ0NzYxX2o1aA.jpg",
          "description": "Không cần lý do đặc biệt\nTrong những cuộc trò chuyện cứ thế tiếp nối tự nhiên\nChúng tôi đã dần hiểu nhau."
        },
        {
          "id": "2",
